        <mxCell id="fTsys_Q68l4_gb95fum5-59" parent="fTsys_Q68l4_gb95fum5-1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;" value="E1 (Po10)" vertex="1">
