        <mxCell id="sJjQ11QNw48ljPe3ya4A-54" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;" value="E1 (Po10)" vertex="1">
